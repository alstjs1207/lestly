{
  "name": "lestly",
  "private": true,
  "type": "module",
  "version": "1.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prebuild": "npm run verify:node && npm run typecheck && npm run verify:worker",
    "prebuild:local": "npm run typecheck:local && npm run db:typegen",
    "build": "react-router build",
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:typegen": "supabase gen types typescript --project-id smbpzlzbvplhtpqggrjf > database.types.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts",
    "test:attendance:ssr": "node tests/attendance-ssr.mjs",
    "test:schedules:ssr": "node tests/student-schedules-ssr.mjs",
    "test:student-types:ssr": "node tests/student-types-ssr.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\"",
    "test:db": "node sql/checks/security-regression.mjs",
    "postinstall": "node scripts/harden-braces.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "verify:node": "node scripts/verify-node.mjs",
    "test:booking-policy:ssr": "node tests/booking-policy-ssr.mjs",
    "test:booking-window:ssr": "node tests/booking-window-ssr.mjs",
    "test:generalization:ssr": "node tests/service-generalization-ssr.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@hcaptcha/react-hcaptcha": "^1.12.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-email/components": "^1.0.12",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@sentry/profiling-node": "^11.8.0",
    "@sentry/react-router": "^11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.1",
    "@tosspayments/tosspayments-sdk": "^2.3.4",
    "@vercel/og": "^0.6.5",
    "@vercel/react-router": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "i18next-resources-to-backend": "^1.2.1",
    "input-otp": "^1.4.2",
    "isbot": "^5.1.17",
    "lucide-react": "^0.482.0",
    "next-themes": "^0.4.6",
    "nprogress": "^0.2.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-router": "^7.18.4",
    "react-turnstile": "^1.1.4",
    "recharts": "^3.6.0",
    "remix-i18next": "^7.1.0",
    "remix-themes": "^2.0.4",
    "resend": "^4.2.0",
    "rrule": "^2.8.1",
    "satori": "^0.12.2",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.51.1",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.0.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20",
    "@types/nprogress": "^0.2.3",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react-router-devtools": "^1.1.0",
    "supabase": "^2.1.1",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "overrides": {
    "ajv": "^8.20.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
